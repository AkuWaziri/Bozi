# Public client configuration. Supabase values are optional for local UI preview.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Set only after BoziCampaignEscrow is deployed and verified on Base mainnet.
NEXT_PUBLIC_BOZI_ESCROW_ADDRESS=

# Server-only secret for future receipt verification API; never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Deployment only: Base RPC endpoint and deployment key should be set in your shell/CI secrets, never committed.
BASE_RPC_URL=https://mainnet.base.org
DEPLOYER_PRIVATE_KEY=
BOZI_FEE_RECIPIENT=
